{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/free-dev-port.mjs && vite",
    "build": "vite build",
    "embed:og-assets": "node scripts/embed-og-visuals.mjs && node scripts/test-og-render.mjs && node scripts/embed-og-assets.mjs",
    "deploy:build": "npm run build && echo '\\n[okcopa] dist/ ready — SFTP upload (context ./dist) or see docs/DEPLOY.md'",
    "pack:html": "npm run build && node scripts/pack-html-zip.mjs",
    "preview:fresh": "vite build && vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "publish": "node scripts/free-dev-port.mjs && vite build && vite preview",
    "latest": "node scripts/serve-latest.mjs",
    "latest:bg": "node scripts/serve-latest-detached.mjs",
    "preview:5291": "vite build && vite preview --host 127.0.0.1 --port 5291 --strictPort",
    "start": "npm run dev",
    "check:5280": "lsof -nP -iTCP:5280 -sTCP:LISTEN || echo 'Nothing listening on 5280'",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "sync:feishu-cars": "node scripts/sync-feishu-car-rentals.mjs",
    "import:cars": "node scripts/import-car-rentals-sheet.mjs",
    "import:hotels": "node scripts/import-hotel-supply.mjs ./data/hotel-supply.xlsx",
    "export:og-matches": "node scripts/export-matches-og.mjs",
    "export:team-flags": "node scripts/export-team-flags.mjs",
    "embed:og-fonts": "node scripts/embed-og-fonts.mjs",
    "import:tickets": "node scripts/import-ticket-wall-supabase.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@fontsource/inter": "^5.2.8",
    "@types/node": "^22.19.18",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "xlsx": "^0.18.5"
  }
}
